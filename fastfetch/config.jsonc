{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt"
  },

  "modules": [
    "hostname",
    "os",
    "host",
    "kernel",
    "uptime",
    "loadavg",
    "cpu",
    "memory",
    "swap",
    "disk",
    "localip",
    {
      "type": "command",
      "text": "tailscale ip -4",
      "key": "Tailscale IP"
    },
    {
      "type": "command",
      "text": "tailscale version | head -1",
      "key": "Tailscale"
    },
    {
      "type": "break"
    },
    {
      "type": "break"
    },
    {
      "type": "break"
    },
    {
      "type": "break"
    },
    {
      "type": "break"
    },
    "colors"
  ]
}
